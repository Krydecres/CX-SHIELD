# Sao chép thành backend/.env rồi điền giá trị. Không commit file .env.
SUPABASE_URL=https://rpfuwnwanlbovozkykee.supabase.co
# Publishable key: Supabase Dashboard > Project Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UMpurMPyAPTxSragH_nw6g_RohrBqvP
# Service role key: Supabase Dashboard > Project Settings > API Keys. Chỉ đặt ở backend, không đưa vào Flutter.
# Cần cho: gửi cảnh báo khi khách góp ý (E2.2), xác nhận thanh toán (E8.2), cập nhật số liệu Google (E3.1).
SUPABASE_SERVICE_ROLE_KEY=
# Tuỳ chọn: bật kiểm tra Place ID với Google Places API (New)
GOOGLE_PLACES_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Tuỳ chọn: kênh cảnh báo Email (E2.1). Để trống thì nút "Gửi thử" báo chưa cấu hình.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Cổng thanh toán VNPAY sandbox (E8.2). Lấy ở email sau khi đăng ký merchant test.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
FRONTEND_URL=http://localhost:3000
